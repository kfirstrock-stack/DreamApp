# Приложение читает только эти две переменные. Запасного ключа в коде нет.
# Для теста:  cp .env.test.example .env.local
# Для прода:  cp .env.production.example .env.local
# В репозиторий можно класть только anon / publishable. Ключ service_role — никогда.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_or_anon_key
