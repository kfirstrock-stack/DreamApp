# Необязательно: значения по умолчанию уже прописаны в src/lib/config.ts.
# Скопируйте в .env.local, если нужно подключиться к другому проекту Supabase.
# Публиковать можно только publishable-ключ (sb_publishable_…). Ключ service_role — никогда.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
