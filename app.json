{
  "expo": {
    "name": "Glimika",
    "slug": "DreamApp",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "dreamapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0E0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "lang": "ru",
      "themeColor": "#0F0E0C"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0E0C",
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "dark": {
            "backgroundColor": "#0F0E0C",
            "image": "./assets/images/splash.png"
          }
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Glimika открывает ваши фото, чтобы вы могли опубликовать их на карте.",
          "cameraPermission": "Glimika использует камеру, чтобы снимать фото для карты."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Glimika показывает ваши недавние снимки, чтобы их можно было выложить на карту.",
          "savePhotosPermission": "Glimika сохраняет снимки в вашу галерею.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Glimika определяет, где сделан снимок, и показывает фото рядом с вами."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e8b304ec-05b1-4e2d-a133-ff7309a97d58"
      }
    },
    "owner": "konstantinkayf",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e8b304ec-05b1-4e2d-a133-ff7309a97d58"
    }
  }
}
