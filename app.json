{
  "expo": {
    "name": "DreamApp",
    "slug": "DreamApp",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "dreamapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1FAAAA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "DreamApp открывает ваши фото, чтобы вы могли опубликовать их на карте.",
          "cameraPermission": "DreamApp использует камеру, чтобы снимать фото для карты."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "DreamApp показывает ваши недавние снимки, чтобы их можно было выложить на карту.",
          "savePhotosPermission": "DreamApp сохраняет снимки в вашу галерею."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DreamApp определяет, где сделан снимок, и показывает фото рядом с вами."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}